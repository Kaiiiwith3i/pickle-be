{
  "name": "pickle-clb-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/functions.js",
  "scripts": {
    "emulators": "npx firebase-tools --non-interactive emulators:start --only auth,firestore --project demo-pickleclb",
    "dev": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-pickleclb tsx watch src/server.ts",
    "build": "esbuild src/functions.ts --bundle --platform=node --target=node20 --outfile=dist/functions.js --external:firebase-functions --external:firebase-admin --external:express",
    "test": "jest",
    "test:api": "cross-env API_TESTS=1 NODE_OPTIONS=--experimental-vm-modules FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-pickleclb jest --forceExit",
    "typecheck": "tsc --noEmit",
    "evaluate": "tsx scripts/evaluate.ts",
    "seed:sample": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-pickleclb tsx scripts/seed.ts",
    "seed:wipe-sample": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-pickleclb tsx scripts/seed.ts --wipe",
    "grant-role": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-pickleclb tsx scripts/grant-role.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  }
}
